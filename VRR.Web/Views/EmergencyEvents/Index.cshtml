@model List<VRR.Domain.Entities.EmergencyEvent>

@{ ViewData["Title"] = "Emergency Events"; }

<h1>Emergency Events</h1>
<a asp-action="Declare" class="btn btn-danger mb-3">Declare New Emergency</a>

<table class="table">
    <thead><tr><th>Type</th><th>Description</th><th>Zones</th><th>Declared</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Type</td>
            <td>@e.Description</td>
            <td>@e.AffectedZone</td>
            <td>@e.DeclaredAt.ToString("g")</td>
            <td><a asp-action="Details" asp-route-id="@e.Id">View</a></td>
        </tr>
    }
    </tbody>
</table>