@model VRR.Domain.Entities.EmergencyEvent

@{
    ViewData["Title"] = "Emergency Details";
    var total = Model.CheckIns.Count;
    var completed = Model.CheckIns.Count(c => c.Status == VRR.Domain.Enums.CheckInStatus.Completed);
    var percent = total == 0 ? 0 : (int)Math.Round(completed * 100.0 / total);
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to Emergency Events</a>

<h1>@Model.Type: @Model.Description</h1>
<p>
    Zones: @Model.AffectedZone | Severity: @Model.Severity |
    Declared: @Model.DeclaredAt.ToString("g") UTC
</p>

<div class="progress mb-3" role="progressbar" aria-label="Check-in completion">
    <div class="progress-bar" style="width: @percent%">@percent%</div>
</div>
<p>@completed of @total check-ins completed.</p>

<table class="table table-striped">
    ...
</table>