@model VRR.Application.DTOs.ResidentRegistrationDto

@{
    ViewData["Title"] = "Resident Registration";
}

<h1>Vulnerable Resident Registry</h1>
<p>Register yourself or a family member for emergency check-in services.</p>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" type="date" class="form-control"
               min="1920-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AddressLine" class="form-label"></label>
        <input asp-for="AddressLine" class="form-control" />
        <span asp-validation-for="AddressLine" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ZipCode" class="form-label"></label>
        <input asp-for="ZipCode" class="form-control" />
        <span asp-validation-for="ZipCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MobilityStatus" class="form-label"></label>
        <select asp-for="MobilityStatus" class="form-select"
                asp-items="Html.GetEnumSelectList<VRR.Domain.Enums.MobilityStatus>()">
        </select>
        <span asp-validation-for="MobilityStatus" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MedicalNeeds" class="form-label"></label>
        <textarea asp-for="MedicalNeeds" class="form-control"></textarea>
        <span asp-validation-for="MedicalNeeds" class="text-danger"></span>
    </div>

    <div class="form-check mb-2">
        <input asp-for="LivesAlone" class="form-check-input" />
        <label asp-for="LivesAlone" class="form-check-label"></label>
    </div>

    <div class="form-check mb-2">
        <input asp-for="HasAirConditioning" class="form-check-input" />
        <label asp-for="HasAirConditioning" class="form-check-label"></label>
    </div>

    <div class="form-check mb-3">
        <input asp-for="HasBackupPower" class="form-check-input" />
        <label asp-for="HasBackupPower" class="form-check-label"></label>
    </div>

    <h4>Emergency Contact</h4>

    <div class="mb-3">
        <label asp-for="EmergencyContactName" class="form-label"></label>
        <input asp-for="EmergencyContactName" class="form-control" />
        <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmergencyContactPhone" class="form-label"></label>
        <input asp-for="EmergencyContactPhone" class="form-control" />
        <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmergencyContactRelationship" class="form-label"></label>
        <input asp-for="EmergencyContactRelationship" class="form-control" />
        <span asp-validation-for="EmergencyContactRelationship" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="ConsentGiven" class="form-check-input" />
        <label asp-for="ConsentGiven" class="form-check-label"></label>
        <span asp-validation-for="ConsentGiven" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Register</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}