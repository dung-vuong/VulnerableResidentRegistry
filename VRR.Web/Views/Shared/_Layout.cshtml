<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vulnerable Resident Registry</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VulnerableResidentRegistry.styles.css" asp-append-version="true" />
    <style>
            :root {
                --vrr-navy: #0b3d5c;
                --vrr-navy-dark: #072a40;
                --vrr-accent: #d64545;
            }
            body { background-color: #f7f8fa; }
            .navbar-vrr {
                background-color: var(--vrr-navy);
            }
            .navbar-vrr .navbar-brand {
                font-weight: 600;
                color: #fff;
                display: flex;
                align-items: center;
                gap: .5rem;
            }
            .navbar-vrr .navbar-brand::before {
                content: "⛨";
                font-size: 1.2rem;
            }
            .navbar-vrr .nav-link {
                color: rgba(255,255,255,.85) !important;
            }
            .navbar-vrr .nav-link:hover,
            .navbar-vrr .nav-link.active {
                color: #fff !important;
                border-bottom: 2px solid var(--vrr-accent);
            }
            .navbar-vrr .navbar-toggler {
                border-color: rgba(255,255,255,.4);
            }
            .staff-badge {
                font-size: .7rem;
                text-transform: uppercase;
                letter-spacing: .05em;
                color: rgba(255,255,255,.55);
                padding: 0 .75rem;
                align-self: center;
            }
            .btn-register-cta {
                background-color: var(--vrr-accent);
                border-color: var(--vrr-accent);
                color: #fff !important;
                border-radius: 4px;
                padding: .375rem 1rem !important;
            }
            .btn-register-cta:hover {
                background-color: #b93a3a;
                border-color: #b93a3a;
                color: #fff !important;
            }
            footer.footer {
                background-color: var(--vrr-navy-dark);
                color: rgba(255,255,255,.7);
            }
            footer.footer a {
                color: rgba(255,255,255,.9);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-vrr box-shadow mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Vulnerable Resident Registry
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User.IsInRole("Admin") || User.IsInRole("EmergencyCoordinator") || User.IsInRole("CaseWorker"))
                        {
                            <li class="nav-item"><span class="staff-badge">Staff</span></li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Residents" asp-action="Dashboard">Residents</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Residents" asp-action="Pending">Pending</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="EmergencyEvents" asp-action="Index">Emergencies</a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AuditLogs" asp-action="Index">Audit Log</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer py-3 mt-4">
        <div class="container d-flex flex-wrap justify-content-between">
            <span>&copy; 2026 Vulnerable Resident Registry</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>